  {
    "name": "SendMessage",
    "description": "Send a message to a local session agent.",
    "requires_approval": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^[^\\n\\r]*$"
            },
            {
              "pattern": "^[\\s\\S]{0,300}$"
            }
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 200
        },
        "message": {
          "type": "string"
        },
        "notify_when_idle": {
          "type": "boolean"
        }
      },
      "required": [
        "to",
        "message"
      ],
      "additionalProperties": false
    }
  },
